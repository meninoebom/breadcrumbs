# Local development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/breadcrumbs
ENVIRONMENT=development
PORT=8100
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Authentication
ADMIN_PASSWORD=your-secure-password-here
JWT_SECRET=your-secret-here  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Weekly Digest
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
CRON_SECRET=your-cron-secret-here  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BASE_URL=https://crumb.blog  # Used in email links
